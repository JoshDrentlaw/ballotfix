{
  // Ballot Fix, phase 0. Permission flags in the tasks below are this app's
  // security policy in executable form; see SECURITY.md. Unlike Parallax Fix
  // (broad by design), phase 0 needs very little: it talks to Anthropic's API and
  // NetFile's public campaign finance export, reads its env, and writes its output
  // directory.
  "name": "ballot-fix",
  "version": "0.1.0",
  "exports": "./src/main.ts",
  "tasks": {
    "dossier": "deno run --env-file=.env --allow-net=api.anthropic.com,netfile.com --allow-env --allow-read --allow-write=out src/main.ts",
    // The web app: same outbound grant, plus listening locally and saving runs to data/.
    // Listening beyond localhost (e.g. HOST=0.0.0.0 in a container) is allowed; set
    // BALLOTFIX_PASSWORD when you do.
    "serve": "deno run --env-file=.env --allow-net=api.anthropic.com,netfile.com,127.0.0.1,localhost,0.0.0.0 --allow-env --allow-read --allow-write=data,out src/serve.ts",
    // Same app with placeholder research: no API key, no cost. Data goes to a temp dir.
    "demo": "deno run --allow-net=127.0.0.1 --allow-env=PORT --allow-read --allow-write examples/demo_server.ts",
    // Why shared connections are empty: a read-only report over data/ballotfix.db, no network.
    "diagnose": "deno run --allow-read --allow-env=BALLOTFIX_DATA_DIR src/diagnose.ts",
    // How much one race's research changes between runs. Spends money: it prints an
    // estimate and stops unless given --yes. --compare reads saved runs and calls nothing.
    "stability": "deno run --env-file=.env --allow-net=api.anthropic.com --allow-env --allow-read --allow-write=out src/stability.ts",
    // Scores runs against a person's judgments and answer key: no network, writes only with --out.
    "answer-key": "deno run --allow-read --allow-write=out src/answer_key.ts",
    "check": "deno fmt --check && deno lint && deno check src/main.ts src/serve.ts src/diagnose.ts src/stability.ts src/answer_key.ts examples/demo_server.ts examples/build_sample.ts",
    "test": "deno test --allow-read --allow-write"
  },
  "fmt": {
    // sample.html is generated by examples/build_sample.ts from src/render.ts;
    // reformatting it would only make it drift from what the renderer emits.
    // static/icon.svg is embedded verbatim in src/render.ts (a test keeps them
    // equal), and deno fmt's SVG output changes between Deno versions.
    "exclude": ["examples/sample.html", "static/icon.svg"],
    "lineWidth": 100,
    "semiColons": true,
    "singleQuote": false
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1",
    "@std/cli": "jsr:@std/cli@^1",
    "@anthropic-ai/sdk": "npm:@anthropic-ai/sdk@^0.128"
  }
}
